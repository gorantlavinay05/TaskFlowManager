{
  "name": "taskflow-manager-root",
  "version": "1.0.0",
  "description": "Root for TaskFlow Manager",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w frontend && mkdir -p backend/dist && cp -r frontend/dist/* backend/dist/",
    "start": "npm start -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
